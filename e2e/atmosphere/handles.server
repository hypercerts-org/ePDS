epds.@@SANDBOX_DOMAIN@@:53 {
  hosts {
    @@GATEWAY_IP@@ epds.@@SANDBOX_DOMAIN@@
    fallthrough
  }
  template IN A epds.@@SANDBOX_DOMAIN@@ {
    match ^[a-z0-9][a-z0-9-]{1,16}[a-z0-9]\.epds\.@@SANDBOX_DOMAIN@@\.$
    answer "{{ .Name }} 60 IN A @@GATEWAY_IP@@"
    fallthrough
  }
}
_lexicon.hypercerts.org:53 {
  errors
  template IN TXT {
    answer "{{ .Name }} 60 IN TXT \"did=did:web:lexicons.@@SANDBOX_DOMAIN@@\""
  }
}
_lexicon.certified.app:53 {
  errors
  template IN TXT {
    answer "{{ .Name }} 60 IN TXT \"did=did:web:lexicons.@@SANDBOX_DOMAIN@@\""
  }
}
