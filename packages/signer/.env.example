# ePDS signer — TEE-side service configuration.
#
# PRODUCTION: run inside a confidential VM (dstack on TDX/SEV-SNP).
# The root seed should be provisioned by the dstack KMS, not by env.
# NEVER deploy the signer to ordinary infrastructure (e.g. Railway).

# Port the signer listens on (internal network only — never expose publicly)
SIGNER_PORT=3010

# Directory for the signer's sqlite store (wallet enrollments + nonces)
SIGNER_DATA_DIR=./data/signer

# Shared secret for PDS -> signer calls (x-internal-secret header).
# Generate with: openssl rand -hex 32
SIGNER_INTERNAL_SECRET=

# Root seed source — exactly one of:
#   SIGNER_ROOT_SEED_HEX  — 64 hex chars (dev, or KMS-injected env)
#   SIGNER_ROOT_SEED_FILE — path to 32-byte / 64-hex seed file
#                           (defaults to $SIGNER_DATA_DIR/root-seed)
# SIGNER_ROOT_SEED_HEX=
# SIGNER_ROOT_SEED_FILE=

# Dev only: allow generating a fresh seed file when none exists.
# MUST be unset in production (the TEE KMS provisions the seed there).
SIGNER_ALLOW_DEV_SEED=1

# Wallet envelope freshness window in seconds (default 120)
# SIGNER_WALLET_FRESHNESS_SEC=120

# dstack guest-agent socket path (default /var/run/dstack.sock)
# SIGNER_DSTACK_SOCK=/var/run/dstack.sock
