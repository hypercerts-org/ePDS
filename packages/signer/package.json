{
  "name": "@certified-app/signer",
  "description": "ePDS TEE signer — holds the root seed, derives per-user repo-signing and wallet keys, and signs on request. Designed to run inside a confidential VM (dstack); runs as a plain process in dev.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@atproto/crypto": "^0.4.5",
    "@certified-app/shared": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.3.1",
    "ed25519-hd-key": "^1.3.0",
    "express": "^4.18.2",
    "jose": "^5.10.0",
    "shamir-secret-sharing": "^0.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
